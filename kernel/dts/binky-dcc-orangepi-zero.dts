/dts-v1/;
#include "allwinner/sun8i-h3.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/sun8i-h3-ccu.h>
#include <dt-bindings/reset/sun8i-h3-ccu.h>

/ {
    model = "BinkyDCC Orange Pi Zero v0.0.2";
    compatible = "allwinner,sun8i-h2-plus", "allwinner,sun8i-h3";

    aliases {
        serial0 = &uart0;
        ethernet0 = &emac;
    };

    chosen {
        stdout-path = "serial0:115200n8";
    };
};

/* Ensure the CPU nodes from the dtsi are activated */
&cpu0 {
    /* The include should provide this, but let's see if the log changes */
    device_type = "cpu";
};

&uart0 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart0_pa_pins>;
    status = "okay";
};

&emac {
    /* * Reference the label already defined in sunxi-h3-h5.dtsi.
     * Do NOT create a new 'int_mii_phy' label in this file.
     */
    phy-handle = <&int_mii_phy>;
    phy-mode = "mii";
    allwinner,leds-active-low;
    status = "okay";
};

&spi1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&spi1_pins>;

    spidev@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <10000000>;
    };
};
